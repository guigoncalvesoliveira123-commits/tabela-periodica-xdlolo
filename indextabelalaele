    <button class="dclose" id="dclose">✕</button>
    <div class="dhead">
      <div class="dsym" style="background:${resolveVar(cat.color)}">${el.sym}</div>
      <div>
        <div class="dname">${el.name}</div>
        <div class="dcat">${cat.label} · Z = ${el.z}</div>
      </div>
    </div>
    <div class="dgrid">
      <div class="dstat"><b>NÚMERO ATÔMICO (Z)</b><span>${el.z}</span></div>
      <div class="dstat"><b>MASSA ATÔMICA</b><span>${el.mass}</span></div>
      <div class="dstat"><b>PERÍODO</b><span>${el.period}</span></div>
      <div class="dstat"><b>GRUPO / FAMÍLIA</b><span>${el.group>0? el.group : '3 (série f)'} — ${cat.label}</span></div>
      <div class="dstat"><b>ELETRONEGATIVIDADE</b><span>${enText}</span></div>
      <div class="dstat"><b>RAIO ATÔMICO (COVALENTE)</b><span>${el.radius} pm</span></div>
      <div class="dstat"><b>CAMADA DE VALÊNCIA</b><span>Camada ${el.valence_letter} · ${el.valence_count} elétron(s)</span></div>
    </div>
    <div class="learn" id="learn"></div>
    <div class="dconfig">${el.config}</div>
    <div class="dbohr">
      <svg id="detailSvg" width="200" height="200" viewBox="0 0 200 200"></svg>
      <div class="note">
        <b>Distribuição por camadas:</b> ${shellsStr}<br><br>
        O anel em destaque (ciano) é a <b>camada de valência</b> — a camada mais externa, responsável pelas ligações químicas deste elemento.
      </div>
    </div>
  `;
  document.getElementById('dclose').addEventListener('click', closeDetail);
  drawBohr(document.getElementById('detailSvg'), el.shells, 200);
  cur = el; editing = false; renderLearn();
  overlay.classList.add('show');
}


// ---------- Saiba mais: história e aplicações, com edição pelo professor ----------
const LEARN_TABS = [["h","História"],["m","Medicina"],["b","Biologia"],["i","Indústria e cotidiano"]];
let cur = null, learnTab = "h", editing = false, canEditNotes = false, notesDb = null, overrides = {};

function learnFields(z){
  const base = INFO[z] || {}, o = overrides[z] || {}, out = {};
  LEARN_TABS.forEach(([k])=>{ out[k] = (typeof o[k]==='string') ? o[k] : (base[k] || ''); });
  return out;
}
function mk(tag, cls, text){
  const n = document.createElement(tag);
  if(cls) n.className = cls;
  if(text !== undefined) n.textContent = text;
  return n;
}

function renderLearn(){
  const box = document.getElementById('learn');
  if(!box || !cur) return;
  box.textContent = '';
  const z = cur.z, f = learnFields(z), base = INFO[z] || {};

  const head = mk('div','learn-head');
  head.appendChild(mk('span','learn-title','SABER MAIS'));
  if(overrides[z]) head.appendChild(mk('span','learn-badge','texto editado pelo professor'));
  if(canEditNotes && notesDb && !editing){
    const eb = mk('button','learn-edit','Editar texto');
    eb.type = 'button';
    eb.addEventListener('click', ()=>{ editing = true; renderLearn(); });
    head.appendChild(eb);
  }
  box.appendChild(head);

  if(!editing){
    const avail = LEARN_TABS.filter(([k])=>f[k]);
    if(!avail.length){ box.appendChild(mk('p','learn-empty','Ainda não há texto para este elemento.')); return; }
    if(!avail.some(([k])=>k===learnTab)) learnTab = avail[0][0];
    const bar = mk('div','learn-tabs');
    bar.setAttribute('role','tablist');
    avail.forEach(([k,label])=>{
      const b = mk('button','learn-tab'+(k===learnTab?' on':''), label);
      b.type = 'button';
      b.setAttribute('role','tab');
      b.setAttribute('aria-selected', k===learnTab ? 'true' : 'false');
      b.addEventListener('click', ()=>{ learnTab = k; renderLearn(); });
      bar.appendChild(b);
    });
    box.appendChild(bar);
    box.appendChild(mk('p','learn-text', f[learnTab]));
    return;
  }

  const areas = {};
  LEARN_TABS.forEach(([k,label])=>{
    const lab = mk('label','learn-lab', label);
    lab.setAttribute('for','ed-'+k);
    const ta = mk('textarea','learn-ta');
    ta.id = 'ed-'+k; ta.rows = 3; ta.value = f[k];
    areas[k] = ta;
    box.appendChild(lab); box.appendChild(ta);
  });
  const row = mk('div','learn-actions');
  const save = mk('button','learn-btn primary','Salvar'); save.type = 'button';
  const cancel = mk('button','learn-btn','Cancelar'); cancel.type = 'button';
  const msg = mk('span','learn-msg','');
  row.appendChild(save); row.appendChild(cancel);

  save.addEventListener('click', async ()=>{
    save.disabled = true; msg.textContent = 'Salvando…';
    const diff = {};
    LEARN_TABS.forEach(([k])=>{ const v = areas[k].value.trim(); if(v !== (base[k]||'')) diff[k] = v; });
    try{
      const ref = notesDb.doc('notas/'+z);
      if(Object.keys(diff).length === 0){ await ref.delete(); delete overrides[z]; }
      else { await ref.set(diff); overrides[z] = diff; }
      editing = false; renderLearn();
    }catch(err){
      msg.textContent = 'Não foi possível salvar. Confira se você entrou com a conta dona da página.';
      save.disabled = false;
    }
  });
  cancel.addEventListener('click', ()=>{ editing = false; renderLearn(); });
  if(overrides[z]){
    const rest = mk('button','learn-btn','Restaurar texto original'); rest.type = 'button';
    rest.addEventListener('click', async ()=>{
      rest.disabled = true; msg.textContent = 'Restaurando…';
      try{ await notesDb.doc('notas/'+z).delete(); delete overrides[z]; editing = false; renderLearn(); }
      catch(err){ msg.textContent = 'Não foi possível restaurar.'; rest.disabled = false; }
    });
    row.appendChild(rest);
  }
  row.appendChild(msg);
  box.appendChild(row);
}

// Edições salvas pelo professor (opcional: sem o banco, a página mostra só o texto original)
(async ()=>{
  try{
    const cl = window.claude;
    if(!cl || !cl.use) return;
    const user = await cl.use('user');
    const db = await cl.use('db');
    if(!db) return;
    notesDb = db;
    canEditNotes = user ? await user.canEdit() : false;
    db.collection('notas').onSnapshot((snap)=>{
      const next = {};
      snap.docs.forEach(d=>{ const v = d.data(); if(v) next[d.id] = v; });
      overrides = next;
      if(cur && !editing && overlay.classList.contains('show')) renderLearn();
    }, ()=>{});
    if(cur && overlay.classList.contains('show') && !editing) renderLearn();
  }catch(e){}
})();

function closeDetail(){ editing = false; overlay.classList.remove('show'); }
overlay.addEventListener('click', (e)=>{ if(e.target===overlay) closeDetail(); });
document.addEventListener('keydown', (e)=>{ if(e.key==='Escape'){ if(editing){ editing = false; renderLearn(); } else closeDetail(); } });

// ---------- Projector mode ----------
document.getElementById('btnProjector').addEventListener('click', (e)=>{
  document.body.classList.toggle('projector');
  const on = document.body.classList.contains('projector');
  e.target.textContent = on ? 'Desativar modo projetor' : 'Ativar modo projetor';
  if(on){ cellSize = 66; applyZoom(); }
});

// ---------- Link direto para um elemento (QR codes): ...#z=8 ou ...?z=8 ----------
function zFromUrl(){
  const m = ((location.search||'')+'&'+(location.hash||'')).match(/[?#&]z=?(\d{1,3})(?!\d)/);
  return m ? ELEMENTS.find(e=>e.z===Number(m[1])) : null;
}
function openFromUrl(){ const el = zFromUrl(); if(el) openDetail(el); }
window.addEventListener('hashchange', openFromUrl);
openFromUrl();
</script>

