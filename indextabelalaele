<title>Tabela Periódica Interativa (Copy)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    color-scheme: dark;
    --bg: #0F1B24;
    --bg-deep: #0A141B;
    --panel: #172530;
    --panel-2: #1D2E3A;
    --line: #2B3E4A;
    --chalk: #EEEDE4;
    --chalk-dim: #B9C4C9;
    --gold: #E7B450;
    --cyan: #6BD8C6;
    --coral: #E96A52;

    --c-alcalino: #E8654D;
    --c-alcalino2: #F0A24E;
    --c-transicao: #5B9AD6;
    --c-pos: #78B679;
    --c-metaloide: #C79BE0;
    --c-naometal: #5FD1C0;
    --c-halogenio: #ECC050;
    --c-gasnobre: #9AA7AC;
    --c-lantanideo: #EF93B4;
    --c-actinideo: #A98CD8;

    --cell: 54px;
    --radius: 3px;
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:
      radial-gradient(1200px 700px at 15% -10%, #142430 0%, transparent 60%),
      radial-gradient(1000px 600px at 100% 0%, #14232c 0%, transparent 55%),
      var(--bg);
    color:var(--chalk);
    font-family:'Inter', sans-serif;
    line-height:1.55;
  }

  ::selection{ background:var(--gold); color:#1a1200; }

  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:600;
    letter-spacing:-0.01em;
    color:var(--chalk);
    margin:0;
  }

  .wrap{ max-width:1180px; margin:0 auto; padding-left:max(28px, env(safe-area-inset-left, 0px)); padding-right:max(28px, env(safe-area-inset-right, 0px)); }

  a{ color:var(--cyan); }

  /* ---------- NAV ---------- */
  nav.topnav{
    position:sticky; top:env(safe-area-inset-top, 0px); z-index:50;
    background:rgba(10,20,27,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav.topnav .wrap{
    display:flex; align-items:center; gap:26px;
    height:58px; overflow-x:auto;
  }
  nav.topnav .brand{
    font-family:'Fraunces', serif; font-weight:600; font-size:17px;
    color:var(--gold); white-space:nowrap; flex-shrink:0;
    display:flex; align-items:center; gap:8px;
  }
  nav.topnav .brand .z{
    font-family:'IBM Plex Mono', monospace; font-size:11px;
    border:1px solid var(--gold); border-radius:2px; padding:1px 5px;
  }
  nav.topnav .links{ display:flex; gap:22px; }
  nav.topnav .links a{
    color:var(--chalk-dim); text-decoration:none; font-size:14px; font-weight:500;
    white-space:nowrap; transition:color .15s;
  }
  nav.topnav .links a:hover{ color:var(--chalk); }

  /* ---------- HERO ---------- */
  header.hero{
    padding:86px 0 70px;
    position:relative;
    overflow:hidden;
    border-bottom:1px solid var(--line);
  }
  header.hero .tile{
    position:absolute;
    right:-40px; top:-60px;
    width:340px; height:340px;
    border:1px solid var(--line);
    border-radius:6px;
    opacity:0.5;
    display:flex; flex-direction:column; justify-content:space-between;
    padding:26px;
    background:linear-gradient(160deg, rgba(107,216,198,0.06), transparent 60%);
    pointer-events:none;
  }
  header.hero .tile .zn{ font-family:'IBM Plex Mono',monospace; font-size:22px; color:var(--cyan); }
  header.hero .tile .sym{ font-family:'Fraunces',serif; font-size:150px; font-weight:600; color:rgba(238,237,228,0.12); line-height:1; }
  header.hero .tile .nm{ font-family:'IBM Plex Mono',monospace; font-size:14px; color:var(--chalk-dim); }

  header.hero .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px; color:var(--cyan);
    display:flex; align-items:center; gap:10px;
    margin-bottom:22px;
  }
  header.hero .eyebrow::before{
    content:''; width:26px; height:1px; background:var(--cyan);
  }
  header.hero h1{
    font-size:clamp(38px,5.4vw,64px);
    max-width:820px;
    line-height:1.05;
  }
  header.hero h1 em{ font-style:normal; color:var(--gold); }
  header.hero p.lede{
    max-width:640px; margin-top:22px;
    font-size:clamp(16px,1.6vw,19px);
    color:var(--chalk-dim);
  }
  header.hero .cta-row{ margin-top:34px; display:flex; gap:14px; flex-wrap:wrap; }
  .btn{
    font-family:'Inter',sans-serif; font-weight:600; font-size:14.5px;
    padding:12px 22px; border-radius:3px; border:1px solid var(--line);
    background:var(--panel); color:var(--chalk); cursor:pointer;
    text-decoration:none; display:inline-flex; align-items:center; gap:8px;
    transition: border-color .15s, transform .1s;
  }
  .btn:hover{ border-color:var(--gold); }
  .btn.primary{ background:var(--gold); color:#1a1200; border-color:var(--gold); }
  .btn.primary:hover{ transform:translateY(-1px); }

  /* ---------- SECTION GENERIC ---------- */
  section{ padding:74px 0; border-bottom:1px solid var(--line); }
  section.tight{ padding:56px 0; }
  .kicker{
    font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:var(--gold);
    margin-bottom:14px; display:block;
  }
  section h2{ font-size:clamp(26px,3vw,36px); max-width:640px; }
  section .lede{ color:var(--chalk-dim); max-width:640px; margin-top:14px; font-size:16px; }

  .grid-2{ display:grid; grid-template-columns:1fr 1fr; gap:48px; margin-top:38px; }
  @media (max-width:860px){ .grid-2{ grid-template-columns:1fr; } }

  .card{
    background:var(--panel); border:1px solid var(--line); border-radius:4px;
    padding:24px 26px;
  }
  .card h3{ font-size:19px; color:var(--gold); margin-bottom:10px; }
  .card p{ color:var(--chalk-dim); font-size:15px; margin:0; }

  /* ---------- NUMERO ATOMICO SECTION ---------- */
  .diagram-atom{
    display:flex; align-items:center; justify-content:center;
    gap:0; margin-top:10px;
  }
  .z-box{
    font-family:'IBM Plex Mono',monospace;
    display:flex; flex-direction:column; align-items:center; gap:6px;
  }

  .fact-list{ list-style:none; margin:22px 0 0; padding:0; display:grid; gap:14px; }
  .fact-list li{
    display:grid; grid-template-columns:120px 1fr; gap:18px;
    border-top:1px solid var(--line); padding-top:14px; font-size:15px;
  }
  .fact-list li b{ color:var(--gold); font-family:'IBM Plex Mono',monospace; font-weight:500; font-size:13.5px; }
  .fact-list li span{ color:var(--chalk-dim); }

  /* ---------- FAMILIES LEGEND / STRIP ---------- */
  .family-strip{
    display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr));
    gap:10px; margin-top:30px;
  }
  .family-chip{
    display:flex; align-items:center; gap:12px;
    background:var(--panel); border:1px solid var(--line); border-radius:3px;
    padding:12px 14px; cursor:pointer; transition:border-color .15s, background .15s;
  }
  .family-chip:hover{ border-color:var(--chalk-dim); }
  .family-chip.active{ border-color:var(--gold); background:var(--panel-2); }
  .family-chip .dot{ width:14px; height:14px; border-radius:2px; flex-shrink:0; }
  .family-chip .txt{ display:flex; flex-direction:column; }
  .family-chip .txt b{ font-size:13.5px; }
  .family-chip .txt span{ font-size:11.5px; color:var(--chalk-dim); font-family:'IBM Plex Mono',monospace; }

  /* ---------- ELECTRONEGATIVITY VISUAL ---------- */
  .en-scale{
    margin-top:30px; height:34px; border-radius:3px;
    background:linear-gradient(90deg,#243444 0%, #2c6e78 25%, #3fa08a 50%, #e7b450 75%, #e96a52 100%);
    position:relative;
  }
  .en-scale .lbl{
    position:absolute; top:42px; font-size:12px; color:var(--chalk-dim); font-family:'IBM Plex Mono',monospace;
    transform:translateX(-50%);
  }
  .en-arrows{ display:flex; justify-content:space-between; margin-top:56px; font-size:13px; color:var(--chalk-dim); }
  .en-arrows span{ display:flex; align-items:center; gap:8px; }

  /* ---------- RADIUS COMPARISON ---------- */
  .radius-compare{ display:flex; flex-wrap:wrap; gap:34px; margin-top:34px; align-items:flex-end; }
  .radius-group{
    background:var(--panel); border:1px solid var(--line); border-radius:4px;
    padding:20px 24px; display:flex; flex-direction:column; gap:8px;
  }
  .radius-group .rg-title{ font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--gold); margin-bottom:6px; }
  .radius-row{ display:flex; align-items:flex-end; gap:22px; }
  .radius-item{ display:flex; flex-direction:column; align-items:center; gap:8px; }
  .radius-item .rc{ border-radius:50%; background:var(--cyan); flex-shrink:0; }
  .radius-item .rl{ font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--chalk-dim); text-align:center; }
  .radius-item .rl b{ color:var(--chalk); display:block; font-size:13px; }

  /* ---------- SHELLS EXPLANATION ---------- */
  .shell-demo{ display:flex; gap:40px; align-items:center; flex-wrap:wrap; margin-top:30px; }
  .shell-demo svg{ background:var(--panel); border:1px solid var(--line); border-radius:6px; }
  .shell-legend{ display:grid; gap:10px; font-size:14.5px; color:var(--chalk-dim); }
  .shell-legend b{ color:var(--chalk); font-family:'IBM Plex Mono',monospace; }

  /* ---------- TABLE SECTION ---------- */
  section#tabela{ padding-bottom:40px; }
  .table-controls{
    display:flex; align-items:center; justify-content:space-between;
    flex-wrap:wrap; gap:16px; margin:30px 0 22px;
  }
  .mode-switch{ display:flex; gap:6px; background:var(--panel); border:1px solid var(--line); border-radius:4px; padding:4px; }
  .mode-switch button{
    font-family:'Inter',sans-serif; font-size:13.5px; font-weight:600;
    padding:9px 16px; border-radius:3px; border:none; background:transparent;
    color:var(--chalk-dim); cursor:pointer; transition:background .15s, color .15s;
  }
  .mode-switch button.active{ background:var(--gold); color:#1a1200; }
  .zoom-controls{ display:flex; align-items:center; gap:8px; }
  .zoom-controls button{
    width:32px; height:32px; border-radius:3px; border:1px solid var(--line);
    background:var(--panel); color:var(--chalk); font-size:16px; cursor:pointer;
  }
  .zoom-controls span{ font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--chalk-dim); width:44px; text-align:center; }

  .table-scroll{ overflow-x:auto; padding-bottom:14px; }
  #grid{
    display:grid;
    grid-template-columns:repeat(18, var(--cell));
    grid-auto-rows:var(--cell);
    gap:3px;
    width:max-content;
    margin:0 auto;
  }
  .cell{
    position:relative;
    border-radius:var(--radius);
    display:flex; flex-direction:column; justify-content:center; align-items:center;
    cursor:pointer;
    color:#0e1216;
    border:1px solid rgba(0,0,0,0.25);
    transition: transform .1s, box-shadow .1s, outline .1s;
    user-select:none;
  }
  .cell:hover{ transform:scale(1.09); z-index:5; box-shadow:0 6px 18px rgba(0,0,0,0.45); }
  .cell.selected{ outline:2.5px solid var(--cyan); outline-offset:1px; z-index:6; }
  .cell .zc{ position:absolute; top:2px; left:4px; font-family:'IBM Plex Mono',monospace; font-size:9px; font-weight:600; opacity:0.75; }
  .cell .symc{ font-family:'Fraunces',serif; font-weight:700; font-size:17px; line-height:1; }
  .cell .valc{ position:absolute; bottom:2px; right:4px; font-family:'IBM Plex Mono',monospace; font-size:8px; font-weight:700; opacity:0.85; }
  .cell.spacer{ background:none; border:none; cursor:default; }
  .cell.spacer:hover{ transform:none; box-shadow:none; }
  .cell.ghost{ background:var(--panel-2); color:var(--chalk-dim); border-style:dashed; font-family:'IBM Plex Mono',monospace; font-size:10px; }
  .cell.nodata{ background:repeating-linear-gradient(45deg, #26343e, #26343e 5px, #1c2830 5px, #1c2830 10px); color:var(--chalk-dim); }

  .table-legend{
    display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:22px;
    font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--chalk-dim);
  }
  .table-legend span{ display:flex; align-items:center; gap:6px; }
  .table-legend i{ width:11px; height:11px; border-radius:2px; display:inline-block; }

  .table-hint{ text-align:center; margin-top:16px; font-size:13.5px; color:var(--chalk-dim); }

  /* ---------- DETAIL PANEL ---------- */
  #overlay{
    position:fixed; inset:0; background:rgba(6,12,16,0.7); backdrop-filter:blur(2px);
    display:none; align-items:center; justify-content:center; z-index:100; padding:20px;
  }
  #overlay.show{ display:flex; }
  #detail{
    width:100%; max-width:760px; max-height:88vh; overflow-y:auto;
    background:var(--panel); border:1px solid var(--line); border-radius:8px;
    padding:36px 40px;
  }
  #detail .dclose{
    float:right; background:none; border:1px solid var(--line); color:var(--chalk-dim);
    width:34px; height:34px; border-radius:3px; cursor:pointer; font-size:16px;
  }
  #detail .dhead{ display:flex; gap:26px; align-items:center; }
  #detail .dsym{
    font-family:'Fraunces',serif; font-weight:700; font-size:72px;
    width:120px; height:120px; border-radius:6px; display:flex; align-items:center; justify-content:center;
    color:#0e1216; flex-shrink:0;
  }
  #detail .dname{ font-family:'Fraunces',serif; font-size:28px; }
  #detail .dcat{ font-family:'IBM Plex Mono',monospace; font-size:13px; color:var(--gold); margin-top:6px; }
  #detail .dgrid{
    margin-top:28px; display:grid; grid-template-columns:1fr 1fr; gap:14px 28px;
  }
  #detail .dstat{ border-top:1px solid var(--line); padding-top:10px; }
  #detail .dstat b{ display:block; font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--chalk-dim); font-weight:500; margin-bottom:4px; }
  #detail .dstat span{ font-size:16.5px; }
  #detail .dconfig{
    margin-top:22px; padding:14px 16px; background:var(--bg-deep); border-radius:4px;
    font-family:'IBM Plex Mono',monospace; font-size:13.5px; color:var(--cyan); word-break:break-word;
  }
  #detail .dbohr{ margin-top:24px; display:flex; gap:26px; align-items:center; flex-wrap:wrap; }
  #detail .dbohr .note{ font-size:13.5px; color:var(--chalk-dim); max-width:280px; }
  #detail .dbohr .note b{ color:var(--chalk); }

  /* ---------- GLOSSARY / RECAP ---------- */
  .recap-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:20px 40px; margin-top:32px; }
  @media (max-width:760px){ .recap-grid{ grid-template-columns:1fr; } }
  .recap-item{ border-top:1px solid var(--line); padding-top:16px; }
  .recap-item b{ color:var(--gold); font-family:'Fraunces',serif; font-size:17px; display:block; margin-bottom:6px; }
  .recap-item p{ margin:0; color:var(--chalk-dim); font-size:14.5px; }

  footer{ padding:34px 0 60px; text-align:center; color:var(--chalk-dim); font-size:13px; }

  /* projector mode: scale up everything */
  body.projector{ font-size:19px; }
  body.projector h2{ font-size:clamp(32px,3.6vw,44px) !important; }
  body.projector .lede{ font-size:18px !important; }
  body.projector .card p, body.projector .fact-list li, body.projector .recap-item p{ font-size:17px !important; }
  body.projector :root{ --cell:60px; }

  @media (max-width:640px){
    header.hero .tile{ display:none; }
    .table-controls{ flex-direction:column; align-items:flex-start; }
    #detail{ padding:26px 22px; }
    #detail .dgrid{ grid-template-columns:1fr; }
  }

  body::before{ content:""; position:fixed; inset:0 0 auto; height:env(safe-area-inset-top, 0px); z-index:60; background:#0A141B; }
  [data-scroll]{ cursor:pointer; }
  [data-scroll]:focus-visible, .btn:focus-visible{ outline:2px solid var(--cyan); outline-offset:2px; }
  .cell{ -webkit-tap-highlight-color:transparent; }
  @media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto; } .cell, .btn{ transition:none; } }

  /* ---------- SABER MAIS (história e aplicações) ---------- */
  .learn{ margin-top:24px; border-top:1px solid var(--line); padding-top:18px; }
  .learn-head{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
  .learn-title{ font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--gold); }
  .learn-badge{ font-size:11.5px; color:var(--cyan); border:1px solid var(--line); border-radius:3px; padding:2px 8px; }
  .learn-edit, .learn-btn, .learn-tab{
    font-family:'Inter',sans-serif; font-weight:600; font-size:13px; padding:8px 14px; border-radius:3px;
    border:1px solid var(--line); background:var(--panel-2); color:var(--chalk); cursor:pointer;
  }
  .learn-edit{ margin-left:auto; }
  .learn-edit:hover, .learn-btn:hover, .learn-tab:hover{ border-color:var(--chalk-dim); }
  .learn-tabs{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
  .learn-tab.on, .learn-btn.primary{ background:var(--gold); color:#1a1200; border-color:var(--gold); }
  .learn-text{ margin:0; font-size:15.5px; line-height:1.65; color:var(--chalk); max-width:62ch; }
  .learn-empty{ margin:0; font-size:14px; color:var(--chalk-dim); }
  .learn-lab{ display:block; margin:12px 0 4px; font-family:'IBM Plex Mono',monospace; font-size:12px; color:var(--chalk-dim); }
  .learn-ta{
    width:100%; background:var(--bg-deep); color:var(--chalk); border:1px solid var(--line); border-radius:3px;
    padding:10px 12px; font-family:'Inter',sans-serif; font-size:14.5px; line-height:1.5; resize:vertical;
  }
  .learn-ta:focus-visible, .learn-edit:focus-visible, .learn-btn:focus-visible, .learn-tab:focus-visible{ outline:2px solid var(--cyan); outline-offset:2px; }
  .learn-actions{ display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin-top:14px; }
  .learn-btn:disabled{ opacity:.55; cursor:default; }
  .learn-msg{ font-size:13px; color:var(--chalk-dim); }
  body.projector .learn-text{ font-size:19px; }
</style>


