// ---------- Bohr diagram (SVG) ----------
function drawBohr(svg, shells, size){
  svg.innerHTML='';
  const cx=size/2, cy=size/2;
  const maxR = size/2 - 14;
  const n = shells.length;
  const step = n>1 ? maxR/n : maxR*0.6;

  // nucleus
  const nucleus = document.createElementNS('http://www.w3.org/2000/svg','circle');
  nucleus.setAttribute('cx',cx); nucleus.setAttribute('cy',cy); nucleus.setAttribute('r', 9);
  nucleus.setAttribute('fill', resolveVar('var(--gold)'));
  svg.appendChild(nucleus);

  shells.forEach((count, idx)=>{
    const r = step*(idx+1);
    const isValence = idx===n-1;
    const ring = document.createElementNS('http://www.w3.org/2000/svg','circle');
    ring.setAttribute('cx',cx); ring.setAttribute('cy',cy); ring.setAttribute('r',r);
    ring.setAttribute('fill','none');
    ring.setAttribute('stroke', isValence ? resolveVar('var(--cyan)') : 'rgba(238,237,228,0.28)');
    ring.setAttribute('stroke-width', isValence ? 2 : 1);
    svg.appendChild(ring);

    for(let i=0;i<count;i++){
      const ang = (2*Math.PI*i/count) - Math.PI/2;
      const ex = cx + r*Math.cos(ang);
      const ey = cy + r*Math.sin(ang);
      const dot = document.createElementNS('http://www.w3.org/2000/svg','circle');
      dot.setAttribute('cx',ex); dot.setAttribute('cy',ey); dot.setAttribute('r', isValence?4.2:3.2);
      dot.setAttribute('fill', isValence ? resolveVar('var(--cyan)') : resolveVar('var(--chalk-dim)'));
      svg.appendChild(dot);
    }
  });
}

drawBohr(document.getElementById('shellDemoSvg'), [2,8,1], 260);

