function valenceColor(n){
  const scale = ["#3a5568","#4c7a80","#5e9c8b","#7fb679","#e7b450","#eda23f","#e96a52","#c94b3f"];
  return scale[(n-1)%8];
}

function enColor(en){
  if(en===null || en===undefined) return null;
  // scale 0.7 -> 4.0
  const t = Math.min(1, Math.max(0,(en-0.7)/(4.0-0.7)));
  const stops = [
    {t:0, c:[58,85,104]},
    {t:0.35, c:[63,160,138]},
    {t:0.65, c:[231,180,80]},
    {t:1, c:[233,106,82]},
  ];
  let a=stops[0], b=stops[stops.length-1];
  for(let i=0;i<stops.length-1;i++){
    if(t>=stops[i].t && t<=stops[i+1].t){ a=stops[i]; b=stops[i+1]; break; }
  }
  const span = (b.t-a.t)||1;
  const lt = (t-a.t)/span;
  const c = a.c.map((v,i)=>Math.round(v+(b.c[i]-v)*lt));
  return `rgb(${c[0]},${c[1]},${c[2]})`;
}

function radiusColor(r){
  // pequeno (28pm) -> grande (260pm), escala invertida em relação à EN
  const t = Math.min(1, Math.max(0,(r-28)/(260-28)));
  const stops = [
    {t:0, c:[233,106,82]},
    {t:0.35, c:[231,180,80]},
    {t:0.65, c:[63,160,138]},
    {t:1, c:[58,85,104]},
  ];
  let a=stops[0], b=stops[stops.length-1];
  for(let i=0;i<stops.length-1;i++){
    if(t>=stops[i].t && t<=stops[i+1].t){ a=stops[i]; b=stops[i+1]; break; }
  }
  const span = (b.t-a.t)||1;
  const lt = (t-a.t)/span;
  const c = a.c.map((v,i)=>Math.round(v+(b.c[i]-v)*lt));
  return `rgb(${c[0]},${c[1]},${c[2]})`;
}

