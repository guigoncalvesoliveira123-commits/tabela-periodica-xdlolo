let currentMode = 'familia';
function setMode(mode, keep){
  currentMode = mode;
  document.querySelectorAll('#modeSwitch button').forEach(b=>b.classList.toggle('active', b.dataset.mode===mode));
  renderLegend(mode);
  document.querySelectorAll('.cell[data-z]').forEach(cellEl=>{
    const el = ELEMENTS.find(e=>e.z==cellEl.dataset.z);
    const valSpan = cellEl.querySelector('.valc');
    valSpan.textContent='';
    cellEl.classList.remove('nodata');
    cellEl.style.opacity = 1;

    if(mode==='familia'){
      const cat = CATS[el.cat];
      cellEl.style.background = resolveVar(cat.color);
      cellEl.style.color = '#10161a';
      if(activeFamily){
        cellEl.style.opacity = (el.cat===activeFamily) ? 1 : 0.18;
      }
    } else if(mode==='eletronegatividade'){
      const col = enColor(el.en);
      if(col){ cellEl.style.background = col; cellEl.style.color='#10161a'; }
      else { cellEl.classList.add('nodata'); cellEl.style.background=''; cellEl.style.color='#B9C4C9'; }
    } else if(mode==='raio'){
      cellEl.style.background = radiusColor(el.radius);
      cellEl.style.color = '#10161a';
      valSpan.textContent = el.radius;
    } else if(mode==='valencia'){
      if(el.val==='variável'){
        cellEl.style.background = resolveVar('var(--c-transicao)');
        cellEl.style.color = '#10161a';
      } else {
        cellEl.style.background = valenceColor(parseInt(el.val));
        cellEl.style.color = '#f2f2f2';
      }
      valSpan.textContent = el.val==='variável' ? 'V' : el.val;
    }
  });
}

